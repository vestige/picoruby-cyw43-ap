class CYW43
  # DHCP-backed access point support supplied by picoruby-cyw43-ap.
  class AP
    def self.enable: (String ssid, String password, ?Integer auth) -> bool
    def self.disable: () -> bool
    def self.active?: () -> bool
    def self.ssid: () -> (String | nil)
    def self.ipv4_address: () -> (String | nil)
    def self.ipv4_netmask: () -> (String | nil)
    def self.client_count: () -> Integer
    def self.stations: () -> Array[String]
    def self.leases: () -> Array[{ mac_address: String, ipv4_address: String, remaining_seconds: Integer }]

    def self.enable_ap_mode: (String ssid, String password, ?Integer auth) -> bool
    def self.disable_ap_mode: () -> bool
    def self.ap_active?: () -> bool
    def self.ap_ssid: () -> (String | nil)
    def self.ap_ipv4_address: () -> (String | nil)
    def self.ap_ipv4_netmask: () -> (String | nil)
  end
end
